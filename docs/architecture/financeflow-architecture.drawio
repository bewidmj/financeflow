          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ui-account" value="REST + bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontColor=#475569;fontSize=11;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="ui" target="account">
          <mxGeometry relative="1" as="geometry"/>
