          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-account-dlt" value="rejected events → DLT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c2410c;strokeWidth=1;dashed=1;endArrow=block;endFill=1;fontColor=#c2410c;fontSize=10;labelBackgroundColor=#f8fafc;exitX=0;exitY=0.85;entryX=1;entryY=0.85;" edge="1" parent="1" source="account" target="kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-identity-db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="identity" target="identity-db">
          <mxGeometry relative="1" as="geometry"/>
