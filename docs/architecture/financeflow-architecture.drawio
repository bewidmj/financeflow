        <mxCell id="e-finance-kafka" value="publish event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1d4ed8;fontSize=11;labelBackgroundColor=#f8fafc;exitX=1;exitY=0.46;entryX=0;entryY=0.46;" edge="1" parent="1" source="finance" target="kafka">
          <mxGeometry relative="1" as="geometry"/>
