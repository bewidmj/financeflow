<mxfile host="app.diagrams.net" modified="2026-10-30T15:10:00.000Z" agent="Copilot" version="24.7.17" type="device">
  <diagram id="financeflow-architecture" name="FinanceFlow Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="header" value="&lt;b&gt;FinanceFlow | System Architecture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c7d2fe&quot; style=&quot;font-size:15px&quot;&gt;Service boundaries, identity trust, event delivery, and independently owned data&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#172554;fontColor=#ffffff;fontSize=26;align=left;verticalAlign=middle;spacingLeft=40;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="102" as="geometry"/>
        </mxCell>
        <mxCell id="client-label" value="CLIENT" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#64748b;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="122" width="150" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="services-label" value="APPLICATIONS &amp; EVENTING" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#64748b;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="382" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="data-label" value="SERVICE-OWNED DATA" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#64748b;fontStyle=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="696" width="250" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;Browser session&lt;br&gt;&lt;font color=&quot;#64748b&quot;&gt;Signs in and manages finances&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="230" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;FinanceFlow UI&lt;/b&gt;&lt;br&gt;React · TypeScript · Vite&lt;hr&gt;Transactions · budgets · accounts&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Local proxy: /identity, /finance, /accounts&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=2;fontColor=#0f172a;fontSize=17;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="175" width="340" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;Identity Service&lt;/b&gt;&lt;br&gt;Spring Boot · :8081&lt;br&gt;&lt;br&gt;Registers users and authenticates sign-ins&lt;br&gt;Issues RS256 access tokens (JWT)&lt;br&gt;Publishes public JWKS&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Private signing key stays here&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f46e5;strokeWidth=2;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="350" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="finance" value="&lt;b&gt;FinanceFlow API&lt;/b&gt;&lt;br&gt;Spring Boot · :8080&lt;br&gt;&lt;br&gt;Transactions · budgets · CSV imports&lt;br&gt;Verifies RS256 JWTs using Identity JWKS&lt;br&gt;Writes transaction + outbox atomically&lt;br&gt;&lt;font color=&quot;#1d4ed8&quot; style=&quot;font-size:12px&quot;&gt;Outbox publisher claims leased rows&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="440" width="350" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="kafka" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;KRaft broker · :9092&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5b21b6&quot;&gt;financeflow.transactions.v1&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c2410c&quot;&gt;financeflow.transactions.v1.dlt&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="475" width="250" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="account" value="&lt;b&gt;Account Service&lt;/b&gt;&lt;br&gt;Spring Boot · :8082&lt;br&gt;&lt;br&gt;Verifies RS256 JWTs via Identity JWKS&lt;br&gt;Consumes versioned transaction events&lt;br&gt;Inbox dedup; validates owner, status, INR&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Applies ordered balance + ledger changes&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="440" width="340" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="identity-db" value="&lt;b&gt;Identity PostgreSQL&lt;/b&gt;&lt;br&gt;Users · credentials · roles&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Identity-owned database&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=15;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="755" width="350" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="finance-db" value="&lt;b&gt;Finance PostgreSQL&lt;/b&gt;&lt;br&gt;Transactions · budgets · CSV import keys&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Includes transactional outbox&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=15;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="755" width="350" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="account-db" value="&lt;b&gt;Account PostgreSQL&lt;/b&gt;&lt;br&gt;Accounts · inbox/state · immutable ledger&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Transfers · owned by Account Service&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=15;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="755" width="340" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="e-user-ui" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontColor=#475569;fontSize=11;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="user" target="ui">
          <mxGeometry relative="1" as="geometry"/>
