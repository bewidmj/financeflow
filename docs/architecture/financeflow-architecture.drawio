        <mxCell id="e-finance-db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="finance" target="finance-db">
          <mxGeometry relative="1" as="geometry"/>
